          "raw": "{{baseUrl}}/pedidos/{{pedidoId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos",
            "{{pedidoId}}",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"em_preparacao\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Extra - Consulta existente (200)",
      "event": [
        {
